{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecurePass",
  "version": "1.0.0",
  "identifier": "com.securepass.app",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/**/*"
    ],
    "copyright": "Copyright 2024 SecurePass",
    "category": "Productivity",
    "shortDescription": "A secure password manager",
    "longDescription": "SecurePass keeps your passwords encrypted and organized."
  }
}