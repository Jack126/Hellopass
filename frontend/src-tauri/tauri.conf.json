{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "SecurePass",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": true,
        "close": true,
        "hide": true,
        "show": true,
        "setTitle": true,
        "maximize": true,
        "unmaximize": true,
        "minimize": true,
        "unminimize": true,
        "startDragging": true
      },
      "notification": {
        "all": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeDir": true,
        "removeFile": true,
        "renameFile": true,
        "exists": true
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.securepass.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "assets/**/*"
      ],
      "externalBin": [],
      "copyright": "Copyright © 2024 SecurePass",
      "category": "Productivity",
      "shortDescription": "A secure password manager",
      "longDescription": "SecurePass is a secure and user-friendly password manager that helps you store and manage your passwords safely.",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      },
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "providerShortName": null,
        "signingIdentity": null
      },
      "linux": {
        "category": "Productivity",
        "desktopTemplate": null,
        "iconTemplate": null,
        "supportsBundle": false
      }
    },
    "security": {
      "csp": null,
      "devCsp": null,
      "protocol": "https",
      "domain": "localhost"
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "title": "SecurePass - Password Manager",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "url": "index.html",
        "fileDropEnabled": false
      }
    ],
    "tray": {
      "icon": {
        "src": "icons/icon.png",
        "width": 32,
        "height": 32
      },
      "title": "SecurePass",
      "menuOnLeftClick": false
    }
  }
}